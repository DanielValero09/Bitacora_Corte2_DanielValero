# Copiar a .env (ignorado por Git) y completar solo con valores privados locales.
# Docker Compose carga .env; Spring Boot fuera de Docker no lo carga.
DB_NAME=american_bites
DB_USER=postgres
DB_PASSWORD=

# Base64 de al menos 32 bytes aleatorios decodificados. No reutilizar fixtures.
JWT_SECRET=
JWT_EXPIRATION_MS=3600000

# Credenciales originales de Mongo; no codificar porcentualmente estos campos.
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
# URI completa: mongodb://<usuario-codificado>:<password-codificado>@mongo:27017/american_bites?authSource=admin
# Usar las mismas credenciales anteriores, percent-encoding en usuario/password.
# Encerrar el valor en comillas simples en .env para conservar $ y # literales.
MONGODB_URI=

# Opcional: dejar ambos vacios mantiene el bootstrap desactivado.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

POSTGRES_HOST_PORT=5433
MONGO_HOST_PORT=27018
